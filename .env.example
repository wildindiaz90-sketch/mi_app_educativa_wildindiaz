# Copia este archivo a .env para desarrollo local
DATABASE_URL=postgres://usuario:clave@localhost:5432/calendario
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
PORT=3000
# Opcional: crea demo@calendario.local con esta clave al ejecutar `npm run seed`
# SEED_DEMO_PASSWORD=
# Opcional: orígenes permitidos por CORS, separados por coma (por defecto, todos)
# CORS_ORIGIN=https://mi-dominio.com
# Fuerza SSL a PostgreSQL (en producción ya se activa; usa false para desactivarlo)
# DATABASE_SSL=true
